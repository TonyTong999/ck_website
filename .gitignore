@'
# Dependencies
node_modules/

# React / Vite build output
dist/
build/
.vite/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Video files
*.mp4
*.mov
*.avi
*.mkv

# Editor files
.vscode/
.idea/
*.swp

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
'@ | Set-Content .gitignore